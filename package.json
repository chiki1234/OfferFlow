{
  "name": "job-hunting-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "tsx scripts/smoke-domain.ts",
    "test:faq-ai": "tsx scripts/smoke-faq-ai.ts",
    "test:auth": "vitest run --config vitest.auth.config.ts",
    "test:watch": "vitest",
    "ai:worker": "tsx scripts/faq-ai-worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "auth:create-user": "tsx scripts/create-user.ts",
    "storage:ensure": "tsx scripts/ensure-bucket.ts",
    "services:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-local-services.ps1",
    "services:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-local-services.ps1",
    "services:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-services.ps1",
    "services:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-local-services.ps1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "better-auth": "1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.37.0",
    "next": "^16.3.3",
    "nodemailer": "^9.1.1",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.3",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
