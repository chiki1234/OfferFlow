<view wx:if="{{sheet}}" class="overlay" bindtap="closeSheet" catchtouchmove="noop">
  <view class="sheet" catchtap="noop">
    <view class="sheet-grip"></view>
    <view class="sheet-header"><view class="sheet-title">{{sheetTitle || (sheet === 'quick' ? '记下一步' : sheet === 'jobDetail' ? '岗位' : sheet === 'agendaDetail' ? '日程' : '资料')}}</view><button class="close-button" bindtap="closeSheet" aria-label="关闭">×</button></view>
    <scroll-view class="sheet-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="sheet-content">
        <block wx:if="{{sheet === 'quick'}}">
          <view class="quick-grid"><button class="quick-tile mint" bindtap="addJob"><text class="quick-symbol">↗</text><text>添加岗位</text></button><button class="quick-tile blue" data-kind="interview" bindtap="addAgenda"><text class="quick-symbol">◷</text><text>安排面试</text></button><button class="quick-tile peach" data-kind="assessment" bindtap="addAgenda"><text class="quick-symbol">⌁</text><text>测评 / 笔试</text></button><button class="quick-tile sand" data-kind="task" bindtap="addAgenda"><text class="quick-symbol">✓</text><text>添加待办</text></button></view>
          <button class="quick-row" data-kind="question" bindtap="addNote">记录面试问题 <text>＋</text></button><button class="quick-row" data-kind="experience" bindtap="addNote">添加经历 <text>＋</text></button><button class="quick-row" bindtap="uploadResume" disabled="{{saving}}">上传简历 <text>↑</text></button>
        </block>

        <block wx:elif="{{sheet === 'job'}}">
          <view class="field"><text class="label">公司</text><input class="input prominent" value="{{form.company}}" data-field="company" bindinput="field" maxlength="80" placeholder="公司名称" /></view>
          <view class="field"><text class="label">岗位</text><input class="input" value="{{form.role}}" data-field="role" bindinput="field" maxlength="100" placeholder="岗位名称" /></view>
          <view class="field-columns"><view class="field"><text class="label">城市</text><input class="input" value="{{form.city}}" data-field="city" bindinput="field" maxlength="60" placeholder="城市" /></view><view class="field"><text class="label">薪资</text><input class="input" value="{{form.salary}}" data-field="salary" bindinput="field" maxlength="60" placeholder="薪资范围" /></view></view>
          <view wx:if="{{!form.id}}" class="field"><text class="label">当前阶段</text><view class="segmented"><button class="{{form.stage === 'planned' ? 'selected' : ''}}" data-field="stage" data-value="planned" bindtap="option">待投递</button><button class="{{form.stage === 'applied' ? 'selected' : ''}}" data-field="stage" data-value="applied" bindtap="option">已投递</button></view></view>
          <view class="field"><text class="label">投递简历</text><picker range="{{resumeOptions}}" range-key="name" data-field="resumeId" data-options="resumeOptions" bindchange="select"><view class="picker-value">{{form.resumeIdLabel}}<text>⌄</text></view></picker></view>
          <view class="field"><text class="label">岗位链接</text><input class="input" value="{{form.url}}" data-field="url" bindinput="field" maxlength="1500" placeholder="https://" /></view>
          <view class="field"><text class="label">岗位描述</text><textarea class="textarea" value="{{form.jd}}" data-field="jd" bindinput="field" maxlength="12000" placeholder="JD" auto-height /></view>
        </block>

        <block wx:elif="{{sheet === 'agenda'}}">
          <view class="segmented"><button wx:for="{{kindOptions}}" wx:key="id" class="{{form.kind === item.id ? 'selected' : ''}}" data-field="kind" data-value="{{item.id}}" bindtap="option">{{item.name}}</button></view>
          <view class="field"><text class="label">名称</text><input class="input prominent" value="{{form.title}}" data-field="title" bindinput="field" maxlength="120" placeholder="{{form.kind === 'interview' ? '例如：产品经理 · 一面' : form.kind === 'assessment' ? '例如：在线笔试' : '待办事项'}}" /></view>
          <view class="field"><text class="label">关联岗位</text><picker range="{{jobOptions}}" range-key="name" data-field="jobId" data-options="jobOptions" bindchange="select"><view class="picker-value">{{form.jobIdLabel}}<text>⌄</text></view></picker></view>
          <view class="field"><text class="label">时间</text><view class="segmented"><button class="{{form.timing === 'slot' ? 'selected' : ''}}" data-field="timing" data-value="slot" bindtap="option">固定时段</button><button class="{{form.timing === 'deadline' ? 'selected' : ''}}" data-field="timing" data-value="deadline" bindtap="option">截止时间</button></view></view>
          <view class="field"><text class="label">{{form.timing === 'slot' ? '开始' : '截止'}}</text><view class="field-columns"><picker mode="date" value="{{form.day}}" data-field="day" bindchange="field"><view class="picker-value">{{form.day}}<text>⌄</text></view></picker><picker mode="time" value="{{form.time}}" data-field="time" bindchange="field"><view class="picker-value">{{form.time}}<text>⌄</text></view></picker></view></view>
          <view wx:if="{{form.timing === 'slot'}}" class="field"><text class="label">结束</text><view class="field-columns"><picker mode="date" value="{{form.endDay}}" data-field="endDay" bindchange="field"><view class="picker-value">{{form.endDay}}<text>⌄</text></view></picker><picker mode="time" value="{{form.endTime}}" data-field="endTime" bindchange="field"><view class="picker-value">{{form.endTime}}<text>⌄</text></view></picker></view></view>
          <view class="field"><text class="label">地点 / 会议链接</text><input class="input" value="{{form.location}}" data-field="location" bindinput="field" maxlength="500" placeholder="地点或会议链接" /></view>
          <view class="field"><text class="label">备注</text><textarea class="textarea" value="{{form.notes}}" data-field="notes" bindinput="field" maxlength="6000" auto-height placeholder="记录要点" /></view>
        </block>

        <block wx:elif="{{sheet === 'question' || sheet === 'experience'}}">
          <view class="field"><text class="label">{{sheet === 'question' ? '问题' : '经历名称'}}</text><textarea class="textarea title-input" value="{{form.title}}" data-field="title" bindinput="field" maxlength="500" auto-height placeholder="{{sheet === 'question' ? '面试问了什么？' : '项目 / 工作经历'}}" /></view>
          <view class="field"><text class="label">{{sheet === 'question' ? '回答' : '经历内容'}}</text><textarea class="textarea large" value="{{form.body}}" data-field="body" bindinput="field" maxlength="16000" auto-height placeholder="{{sheet === 'question' ? '写下你的回答' : '背景、行动与结果'}}" /></view>
          <view class="field"><text class="label">分类</text><input class="input" value="{{form.category}}" data-field="category" bindinput="field" maxlength="40" placeholder="分类名称" /></view>
          <view wx:if="{{sheet === 'question'}}" class="field"><text class="label">关联经历</text><picker range="{{experienceOptions}}" range-key="name" data-field="experienceId" data-options="experienceOptions" bindchange="select"><view class="picker-value">{{form.experienceIdLabel}}<text>⌄</text></view></picker></view>
        </block>

        <block wx:elif="{{sheet === 'review'}}"><view class="field"><textarea class="textarea review-input" value="{{form.review}}" data-field="review" bindinput="field" maxlength="12000" auto-height placeholder="表现、收获、下一次的改进" /></view></block>
        <block wx:elif="{{sheet === 'progress'}}"><view class="field"><textarea class="textarea large" value="{{form.summary}}" data-field="summary" bindinput="field" maxlength="1000" auto-height placeholder="记下新的进展" /></view></block>
        <block wx:elif="{{sheet === 'bulk'}}"><view class="field"><text class="label">问题清单</text><textarea class="textarea large" value="{{form.lines}}" data-field="lines" bindinput="field" maxlength="20000" auto-height placeholder="每行一个问题" /></view><view class="field"><text class="label">分类</text><input class="input" value="{{form.category}}" data-field="category" bindinput="field" maxlength="40" placeholder="分类名称" /></view><view class="field"><text class="label">关联经历</text><picker range="{{experienceOptions}}" range-key="name" data-field="experienceId" data-options="experienceOptions" bindchange="select"><view class="picker-value">{{form.experienceIdLabel}}<text>⌄</text></view></picker></view></block>
        <block wx:elif="{{sheet === 'textAsset'}}"><text class="body-text" selectable>{{form.body}}</text></block>

        <block wx:elif="{{sheet === 'jobDetail'}}">
          <view class="detail-company"><view class="company-avatar {{detail.shade}}">{{detail.initial}}</view><view class="row-grow"><view class="detail-title">{{detail.company}}</view><view class="detail-subtitle">{{detail.role}}</view></view><button class="star-button {{detail.starred ? 'starred' : ''}}" data-id="{{detail.id}}" bindtap="starJob">{{detail.starred ? '★' : '☆'}}</button></view>
          <view class="job-chips"><text class="stage-chip stage-{{detail.stage}}">{{detail.stageName}}</text><text wx:if="{{detail.city}}" class="subtle-chip">{{detail.city}}</text><text wx:if="{{detail.salary}}" class="salary">{{detail.salary}}</text></view>
          <view class="action-pair"><button class="primary" bindtap="changeStage">更新进度</button><button class="secondary" bindtap="editJob">编辑岗位</button></view>
          <view wx:if="{{detail.canSchedule}}" class="inline-actions"><button data-job="{{detail.id}}" data-kind="interview" bindtap="addAgenda">＋ 面试</button><button data-job="{{detail.id}}" data-kind="assessment" bindtap="addAgenda">＋ 测评</button><button data-job="{{detail.id}}" data-kind="task" bindtap="addAgenda">＋ 待办</button></view>
          <block wx:if="{{detail.agenda.length}}"><view class="detail-section-title">日程</view><view wx:for="{{detail.agenda}}" wx:key="id" class="compact-row" data-id="{{item.id}}" bindtap="openAgenda"><view class="row-grow"><view class="card-title">{{item.title}}</view><view class="card-meta">{{item.dateText}} {{item.time}}</view></view><text class="muted">{{item.needsReview ? '待复盘' : item.statusText || '查看'}} ↗</text></view></block>
          <block wx:if="{{detail.resumeName}}"><view class="detail-section-title">投递简历</view><button class="file-link" data-id="{{detail.resumeId}}" bindtap="previewResume"><view class="pdf-icon small-pdf">PDF</view><text>{{detail.resumeName}}</text><text>↗</text></button></block>
          <block wx:if="{{detail.jd}}"><view class="detail-section-title">岗位描述</view><text class="body-text" selectable>{{detail.jd}}</text></block>
          <view class="section-heading"><view class="detail-section-title">JD 附件</view><button class="text-button" data-kind="jd" data-owner="{{detail.id}}" bindtap="uploadResume">＋ 图片</button></view><view wx:for="{{detail.assets}}" wx:key="id" class="attachment-row"><button class="attachment-name" data-id="{{item.id}}" bindtap="openAsset">{{item.name}} ↗</button><button class="attachment-delete" data-id="{{item.id}}" bindtap="deleteAsset" aria-label="删除附件">×</button></view>
          <button wx:if="{{detail.url}}" class="secondary link-button" data-text="{{detail.url}}" bindtap="copy">复制岗位链接 ↗</button>
          <block wx:if="{{detail.notes.length}}"><view class="detail-section-title">面试问题</view><view wx:for="{{detail.notes}}" wx:key="id" class="compact-row" data-id="{{item.id}}" bindtap="openNote"><text class="row-grow">{{item.title}}</text><text>↗</text></view></block>
          <view class="section-heading"><view class="detail-section-title">进展</view><button class="text-button" bindtap="recordProgress">＋ 记录</button></view><view wx:for="{{detail.events}}" wx:key="id" class="timeline-row"><view class="timeline-dot"></view><view><view>{{item.title}}</view><view class="card-meta">{{item.dateText}}</view></view></view>
          <button class="delete-button" bindtap="remove">删除岗位</button>
        </block>

        <block wx:elif="{{sheet === 'agendaDetail'}}">
          <view class="note-tag">{{detail.kindName}}</view><view class="detail-title spaced">{{detail.title}}</view><view class="detail-subtitle">{{detail.company}} {{detail.role}}</view>
          <view class="time-block"><text>{{detail.dateText}}</text><text class="time-block-value">{{detail.time}}{{detail.timing === 'slot' ? ' — ' + detail.endTime : ' 截止'}}</text><text wx:if="{{detail.statusText}}" class="muted">{{detail.statusText}}</text></view>
          <button wx:if="{{detail.location}}" class="location-block" data-text="{{detail.location}}" bindtap="copy"><text>{{detail.location}}</text><text>复制</text></button>
          <text wx:if="{{detail.notes}}" class="body-text" selectable>{{detail.notes}}</text>
          <block wx:if="{{detail.kind === 'interview'}}"><view class="section-heading"><view class="detail-section-title">面试材料</view><button class="text-button" data-kind="transcript" data-owner="{{detail.id}}" bindtap="uploadResume">＋ 文件</button></view><view wx:for="{{detail.assets}}" wx:key="id" class="attachment-row"><button class="attachment-name" data-id="{{item.id}}" bindtap="openAsset">{{item.name}} ↗</button><button class="attachment-delete" data-id="{{item.id}}" bindtap="deleteAsset" aria-label="删除附件">×</button></view></block>
          <view wx:if="{{detail.status === 'pending'}}" class="action-pair"><button class="primary" data-id="{{detail.id}}" bindtap="completeAgenda" disabled="{{saving}}">完成{{detail.kindName}}</button><button class="secondary" bindtap="editAgenda">调整安排</button></view>
          <block wx:if="{{detail.kind === 'interview' ? detail.status === 'done' : false}}">
            <view class="action-pair"><button class="primary" data-id="{{detail.id}}" bindtap="review">{{detail.reviewed ? '编辑复盘' : '写复盘'}}</button><button class="secondary" data-source="{{detail.id}}" data-job="{{detail.jobId}}" data-kind="question" bindtap="addNote">记录问题</button></view>
            <block wx:if="{{detail.review}}"><view class="detail-section-title">复盘</view><text class="body-text" selectable>{{detail.review}}</text></block>
          </block>
          <button wx:if="{{detail.jobId}}" class="quick-row" data-id="{{detail.jobId}}" bindtap="openJob">查看岗位 <text>↗</text></button>
          <button wx:if="{{detail.status === 'pending'}}" class="delete-button" bindtap="cancelAgenda">取消日程</button>
        </block>

        <block wx:elif="{{sheet === 'noteDetail'}}">
          <view class="note-tag">{{detail.category || (detail.kind === 'question' ? '面试问题' : '项目经历')}}</view><view class="detail-title spaced">{{detail.title}}</view><text wx:if="{{detail.body}}" class="body-text" selectable>{{detail.body}}</text>
          <view wx:if="{{detail.experienceName || detail.company || detail.sourceName}}" class="note-source spaced">{{detail.company}} {{detail.sourceName}} {{detail.experienceName}}</view>
          <button class="primary" bindtap="editNote">编辑{{detail.kind === 'question' ? '问题' : '经历'}}</button>
          <block wx:if="{{detail.questions.length}}"><view class="detail-section-title">关联问题</view><view wx:for="{{detail.questions}}" wx:key="id" class="compact-row" data-id="{{item.id}}" bindtap="openNote"><text class="row-grow">{{item.title}}</text><text>↗</text></view></block>
          <button class="delete-button" bindtap="remove">删除{{detail.kind === 'question' ? '问题' : '经历'}}</button>
        </block>

        <block wx:elif="{{sheet === 'resume'}}">
          <button class="file-preview" bindtap="previewResume"><view class="pdf-icon">PDF</view><text class="row-grow">预览简历</text><text>↗</text></button>
          <view class="field"><text class="label">名称</text><input class="input" value="{{form.name}}" data-field="name" bindinput="field" maxlength="120" /></view>
          <view class="detail-section-title">关联经历</view><button wx:for="{{form.experiences}}" wx:key="id" class="experience-choice" data-id="{{item.id}}" bindtap="selectExperience"><text>{{item.title}}</text><view class="choice-check {{item.selected ? 'checked' : ''}}">{{item.selected ? '✓' : ''}}</view></button><view wx:if="{{!form.experiences.length}}" class="empty-inline">暂无经历</view>
          <button class="delete-button" bindtap="remove">删除简历</button>
        </block>

        <block wx:elif="{{sheet === 'settings'}}">
          <view class="settings-brand">OfferFlow<view class="brand-accent"></view></view>
          <button class="quick-row" bindtap="exportData" disabled="{{!loaded}}">导出全部资料 <text>↗</text></button><button class="quick-row" bindtap="openPrivacy">隐私保护指引 <text>↗</text></button>
          <button wx:if="{{cleanupPending}}" class="quick-row" bindtap="cleanupFiles">清理待删除文件 <text>↗</text></button>
          <button class="delete-button" bindtap="clearData" disabled="{{!loaded}}">清空所有资料</button>
        </block>
        <view class="sheet-end"></view>
      </view>
    </scroll-view>
    <view wx:if="{{sheet === 'job' || sheet === 'agenda' || sheet === 'question' || sheet === 'experience' || sheet === 'review' || sheet === 'resume' || sheet === 'progress' || sheet === 'bulk'}}" class="sheet-footer"><button class="primary" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存</button></view>
  </view>
</view>
