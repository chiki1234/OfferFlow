.choice-check.checked { background: #63854d; color: #fff; border-color: #63854d; }
.settings-brand { font-size: 48rpx; font-weight: 600; padding: 30rpx 0 40rpx; letter-spacing: -2rpx; display: flex; align-items: center; gap: 12rpx; }
.brand-accent { width: 11rpx; height: 11rpx; border-radius: 50%; background: #a4b57c; }
.privacy-overlay { z-index: 30; align-items: center; justify-content: center; }
.privacy-card { width: 630rpx; padding: 40rpx; background: #fafbf7; border-radius: 28rpx; }
.privacy-link { padding: 36rpx 0; color: #688753; font-size: 25rpx; }
.privacy-card .secondary { margin-top: 15rpx; }
.library-actions { display: flex; gap: 27rpx; }
.upload-recovery { display: flex; justify-content: space-between; gap: 20rpx; padding: 17rpx 20rpx; background: #eee6db; color: #9b775b; border-radius: 15rpx; font-size: 24rpx; }
.upload-recovery button { min-height: 60rpx; display: flex; align-items: center; }
.attachment-row { display: flex; align-items: center; gap: 14rpx; border-bottom: 1rpx solid #e6ecdc; }
.attachment-name { flex: 1; font-size: 25rpx; min-width: 0; overflow-wrap: anywhere; padding: 24rpx 0; }
.attachment-delete { width: 70rpx; height: 80rpx; text-align: center; font-size: 34rpx; color: #a49a87; }
.load-more { margin: 25rpx auto; text-align: center; padding: 20rpx; color: #819274; font-size: 25rpx; }
