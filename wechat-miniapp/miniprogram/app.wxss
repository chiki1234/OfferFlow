page { background: #f5f5f0; color: #24392f; font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif; font-size: 28rpx; line-height: 1.5; }
view, button, input, textarea, scroll-view { box-sizing: border-box; }
button { margin: 0; padding: 0; border-radius: 0; background: transparent; color: inherit; font-size: inherit; line-height: inherit; text-align: left; }
button::after { border: 0; }
button[disabled] { background: transparent; color: #a0a8a2; opacity: .6; }
button:active { opacity: .75; }
input, textarea { color: #24392f; font-size: 28rpx; }
.app { padding: 0 36rpx; min-height: 100vh; }
.locked { overflow: hidden; }
.topline { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 0 12rpx; }
