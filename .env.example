DATABASE_URL=postgresql://job_hunting:job_hunting@localhost:5432/job_hunting
APP_URL=http://localhost:3000
# password 为账号密码模式；local 仅用于 CI 或可信的单用户开发环境。
AUTH_MODE=password
ALLOW_LOCAL_AUTH_IN_PRODUCTION=false
APP_USER_ID=00000000-0000-4000-8000-000000000001
# 账号密码模式必须使用至少 32 字符的随机密钥，并在所有实例之间保持一致。
AUTH_SECRET=replace-with-at-least-32-random-characters
# 本地开发可使用示例值；生产环境请生成独有的 16/24/32 字节 Base64 AES 密钥，并在构建与运行实例间保持一致。
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
DEPLOYMENT_VERSION=local
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=job-hunting
S3_ACCESS_KEY=minio
S3_SECRET_KEY=replace-with-a-local-secret
# AI_BASE_URL 包含 /v1，不包含 /chat/completions；留空不影响直接导入。
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# 单次 AI 请求超时，单位秒（5-600）。
AI_TIMEOUT=120
# web 使用 Next.js after；公网部署建议 worker，并单独运行 pnpm ai:worker。
AI_EXECUTOR=web
# 完整 AI 调用日志包含问答正文，仅限管理员访问；生产环境应指向私有持久化目录。
AI_LOG_DIR=.runtime/logs/ai
